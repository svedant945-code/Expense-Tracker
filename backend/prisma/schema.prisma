// Prisma Schema for Expense Tracker with Supabase Auth + RLS
// This schema uses Supabase's auth.users as the source of truth
// RLS policies handle user isolation at the database level

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CASH
  BANK
  WALLET
  CREDIT_CARD
  OTHER
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  INCOME_GOAL_REACHED
  RECURRING_DUE
  SAVINGS_GOAL_REACHED
  LOW_BALANCE
}

// User profile table - links to Supabase auth.users via id
// RLS policies on this table ensure users only see their own profile
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  transactions      Transaction[]
  categories        Category[]
  budgets           Budget[]
  accounts          Account[]
  incomeGoals       IncomeGoal[]
  preferences       UserPreferences?
  recurringTx       RecurringTransaction[]
  savingsGoals      SavingsGoal[]
  notifications     Notification[]

  @@map("users")
}

// Categories - user-specific custom categories + system defaults
model Category {
  id          String    @id @default(uuid())
  userId      String?   // Null = system/default category (shared)
  name        String
  type        TransactionType
  icon        String?
  color       String?
  isDefault   Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets     Budget[]
  recurringTx RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
  @@index([type])
  @@map("categories")
}

// Core financial transactions
model Transaction {
  id              String    @id @default(uuid())
  userId          String
  title           String
  description     String?
  amount          Decimal   @db.Decimal(12, 2)
  type            TransactionType
  categoryId      String
  transactionDate DateTime  @db.Date
  paymentMethod   String?
  notes           String?
  accountId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@index([categoryId])
  @@map("transactions")
}

// Financial accounts (cash, bank, wallet, etc.)
model Account {
  id              String     @id @default(uuid())
  userId          String
  name            String
  type            AccountType
  initialBalance  Decimal    @default(0) @db.Decimal(12, 2)
  currentBalance  Decimal    @default(0) @db.Decimal(12, 2)
  currency        String     @default("PKR")
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  recurringTx     RecurringTransaction[]

  @@index([userId])
  @@map("accounts")
}

// Monthly budgets - can be category-specific or overall
model Budget {
  id          String    @id @default(uuid())
  userId      String
  categoryId  String?   // Null = overall budget for all categories
  amount      Decimal   @db.Decimal(12, 2)
  month       Int       // 1-12
  year        Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
  @@map("budgets")
}

// Monthly income goals
model IncomeGoal {
  id        String   @id @default(uuid())
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  month     Int      // 1-12
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId, month, year])
  @@map("income_goals")
}

// Recurring transactions (subscriptions, bills, salary)
model RecurringTransaction {
  id              String             @id @default(uuid())
  userId          String
  title           String
  description     String?
  amount          Decimal            @db.Decimal(12, 2)
  type            TransactionType
  categoryId      String
  frequency       RecurringFrequency
  startDate       DateTime           @db.Date
  endDate         DateTime?          @db.Date
  paymentMethod   String?
  notes           String?
  accountId       String?
  isActive        Boolean            @default(true)
  lastProcessed   DateTime?          @db.Date
  nextDueDate     DateTime           @db.Date
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account         Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isActive])
  @@index([nextDueDate])
  @@map("recurring_transactions")
}

// Savings goals
model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  targetDate    DateTime? @db.Date
  color         String?
  icon          String?
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}

// User preferences
model UserPreferences {
  id                    String   @id @default(uuid())
  userId                String   @unique
  theme                 String   @default("light") // light, dark, system
  currency              String   @default("PKR")
  dateFormat            String   @default("YYYY-MM-DD")
  language              String   @default("en")
  weeklyStartDay        Int      @default(0) // 0=Sunday, 1=Monday
  notificationsEnabled  Boolean  @default(true)
  emailReports          Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  readAt    DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}