# Copy this file to .env and provide values from your Supabase project.
# Never commit .env or expose the service-role key to browser code.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Use the Supabase pooler URL for runtime and the direct URL for migrations.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
