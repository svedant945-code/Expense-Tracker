# ============================================================
# Expense Tracker Backend - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# Get these from: Supabase Dashboard → Settings → API
# ------------------------------------------------------------------
# Project URL (e.g., https://abcdefghijklmnop.supabase.co)
SUPABASE_URL= https://nocfqhhfizqtnvoolpyp.supabase.co

# Anon/Public key (safe for client-side)
SUPABASE_ANON_KEY= sb_publishable_Pv7anTLyg0apBKjgwWKF2Q_N18p3p1T

# Service Role key (SECRET - backend only! Never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Database Connection (REQUIRED)
# Get these from: Supabase Dashboard → Settings → Database
# ------------------------------------------------------------------
# Pooled connection (for runtime - uses PgBouncer)
# Format: postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.nocfqhhfizqtnvoolpyp.supabase.co:5432/postgres

# Direct connection (for migrations - bypasses PgBouncer)
# Format: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.nocfqhhfizqtnvoolpyp.supabase.co:5432/postgres

# ------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5500

# JWT Secret (for any custom tokens - generate with: openssl rand -base64 64)
JWT_SECRET=

# ------------------------------------------------------------------
# Optional: Email (for notifications, password reset, etc.)
# ------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@yourdomain.com

# ------------------------------------------------------------------
# Optional: Redis (for caching, rate limiting, sessions)
# ------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# Optional: Monitoring/Logging
# ------------------------------------------------------------------
# LOG_LEVEL=info
# SENTRY_DSN=